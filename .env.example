# chora-tenancy local Docker configuration
CHORA_ENV=local
PORT=8080
CHORA_GRPC_PORT=9090

POSTGRES_DB=chora_tenancy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

CHORA_DB_DSN=postgres://postgres:postgres@postgres:5432/chora_tenancy?sslmode=disable
CHORA_OUTBOX_DSN=postgres://postgres:postgres@postgres:5432/chora_tenancy?sslmode=disable
CHORA_OUTBOX_WORKER_ID=chora-tenancy-local

# Event bus — NATS JetStream. Unset disables the bus (in-memory fallback).
NATS_URL=nats://nats:4222
NATS_PORT=4222
NATS_MONITOR_PORT=8222
CHORA_SOURCE_PROJECT=chora-local
CHORA_SOURCE_SERVICE=chora-tenancy

# Object storage — MinIO / any S3-compatible endpoint (ADR-205 exports).
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=chora
S3_SECRET_ACCESS_KEY=chora
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Empty keeps the transaction-export worker disabled.
CHORA_TENANCY_EXPORT_BUCKET=

# Tracing — OTLP/gRPC endpoint (the OTel Collector). Unset falls back to stdout.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Optional Stripe integration. Leave empty to use the local stub.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel
